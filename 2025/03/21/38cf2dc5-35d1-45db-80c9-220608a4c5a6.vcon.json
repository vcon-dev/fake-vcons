    {
      "type": "text",
      "start": "2025-03-21T11:56:26-04:00",
      "parties": [
        0
      ],
      "originator": 0,
      "body": "Thank you. And for security purposes, can you confirm the street name of the address on your policy?",
      "mediatype": "text/plain"
