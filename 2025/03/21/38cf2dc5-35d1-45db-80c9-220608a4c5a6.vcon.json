      "start": "2025-03-21T11:48:17-04:00",
      "parties": [
        0
      ],
      "originator": 0,
      "body": "Nice to meet you, Janet. Could you please provide me with your policy number?",
      "mediatype": "text/plain"
    },
    {
      "type": "text",
      "start": "2025-03-21T11:53:00-04:00",
      "parties": [
        1
      ],
      "originator": 1,
      "body": "Of course, it's one two three four five.",
