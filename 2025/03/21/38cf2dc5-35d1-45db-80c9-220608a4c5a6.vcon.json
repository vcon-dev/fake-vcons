      "start": "2025-03-21T12:18:34-04:00",
      "parties": [
        0
      ],
      "originator": 0,
      "body": "Thank you, Janet. I will update your policy with the new vehicle information. Is there anything else I can help you with today?",
      "mediatype": "text/plain"
