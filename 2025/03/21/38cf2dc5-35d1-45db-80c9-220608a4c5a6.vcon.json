    {
      "type": "text",
      "start": "2025-03-21T12:12:56-04:00",
      "parties": [
        0
      ],
      "originator": 0,
      "body": "Sure thing, Janet. Let's get that taken care of. Could you provide me with the make, model, and year of the vehicle you want to add?",
      "mediatype": "text/plain"
    },
    {
      "type": "text",
      "start": "2025-03-21T12:15:20-04:00",
      "parties": [
        1
      ],
      "originator": 1,
